# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password

# Session cookie signing
SESSION_SECRET=random-secret

# Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage buckets (optional; defaults to blog_images / blog_videos)
# BLOG_IMAGES_BUCKET=blog_images
# BLOG_VIDEOS_BUCKET=blog_videos

# Blog timezone (IANA name) for archive year/month/day grouping and the
# server-rendered fallback timestamp. Display in the Feed is the reader's own
# local time regardless of this value. Default: Asia/Karachi.
BLOG_TIMEZONE=Asia/Karachi